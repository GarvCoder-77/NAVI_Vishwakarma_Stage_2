<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="blind_assistant_robot">

  <!-- Materials -->
  <material name="chassis_metal">
    <color rgba="0.72 0.74 0.78 1.0"/>
  </material>
  <material name="tire_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="caster_metal">
    <color rgba="0.65 0.65 0.68 1.0"/>
  </material>
  <material name="lidar_turret">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="camera_lens">
    <color rgba="0.05 0.25 0.45 1.0"/>
  </material>

  <!-- Base footprint (Ground Projection) -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- Base Link (SolidWorks Chassis Assembly) -->
  <!-- Combines Robot_body1, Robot_body2, Robot_body3/4, Side_pannel with 6 vents, and Slab -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://blind_assistant_robot/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.038" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.19 0.076"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="2.8"/>
      <inertia ixx="0.016" ixy="0" ixz="0" iyy="0.018" iyz="0" izz="0.022"/>
    </inertial>
  </link>

  <!-- Left Wheel (from wheel.SLDPRT) -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://blind_assistant_robot/meshes/wheel.stl"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00018"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.088 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Wheel (from wheel.SLDPRT) -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://blind_assistant_robot/meshes/wheel.stl"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00018"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.088 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Caster Wheel (from 1.5 inch Caster Wheel.SLDPRT & HOUSING) -->
  <link name="rear_caster">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://blind_assistant_robot/meshes/caster.stl"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0175"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.10 0 -0.014" rpy="0 0 0"/>
  </joint>

  <!-- Front Support Contact (low friction skid contact) -->
  <link name="front_support">
    <collision>
      <geometry>
        <sphere radius="0.0135"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <joint name="front_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_support"/>
    <origin xyz="0.10 0 -0.018" rpy="0 0 0"/>
  </joint>

  <!-- YDLidar X4 Mount & Link (from LiDAR.SLDPRT mounted on Slab) -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://blind_assistant_robot/meshes/ydlidar_x4.stl"/>
      </geometry>
      <material name="lidar_turret"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.22"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.0 0 0.081" rpy="0 0 0"/>
  </joint>

  <!-- Camera Link (peering through front plate aperture) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.008"/>
      </geometry>
      <material name="camera_lens"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.03 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.062 0 0.052" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo RGB-D Depth Perception Camera Sensor (Intel RealSense D435i Style) -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.15</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
      <frame_id>camera_link</frame_id>
    </sensor>
  </gazebo>

  <!-- Gazebo Material Styling -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.65 0.68 0.72 1.0</ambient>
        <diffuse>0.72 0.75 0.78 1.0</diffuse>
        <specular>0.3 0.3 0.35 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="left_wheel">
    <visual>
      <material>
        <ambient>0.12 0.12 0.12 1.0</ambient>
        <diffuse>0.18 0.18 0.18 1.0</diffuse>
      </material>
    </visual>
    <surface>
      <friction>
        <ode>
          <mu>1.2</mu>
          <mu2>1.2</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="right_wheel">
    <visual>
      <material>
        <ambient>0.12 0.12 0.12 1.0</ambient>
        <diffuse>0.18 0.18 0.18 1.0</diffuse>
      </material>
    </visual>
    <surface>
      <friction>
        <ode>
          <mu>1.2</mu>
          <mu2>1.2</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="rear_caster">
    <visual>
      <material>
        <ambient>0.6 0.6 0.65 1.0</ambient>
        <diffuse>0.7 0.7 0.72 1.0</diffuse>
      </material>
    </visual>
    <surface>
      <friction>
        <ode>
          <mu>0.001</mu>
          <mu2>0.001</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="front_support">
    <surface>
      <friction>
        <ode>
          <mu>0.001</mu>
          <mu2>0.001</mu2>
        </ode>
      </friction>
    </surface>
  </gazebo>

  <gazebo reference="laser_frame">
    <visual>
      <material>
        <ambient>0.08 0.08 0.1 1.0</ambient>
        <diffuse>0.12 0.12 0.14 1.0</diffuse>
      </material>
    </visual>
    <sensor name="ydlidar_x4" type="gpu_lidar">
      <pose>0 0 0.02 0 0 0</pose>
      <topic>/scan</topic>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <frame_id>laser_frame</frame_id>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.176</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_acceleration>1.2</max_linear_acceleration>
      <min_linear_acceleration>-1.2</min_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <min_angular_acceleration>-2.5</min_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_torque>40.0</max_torque>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
