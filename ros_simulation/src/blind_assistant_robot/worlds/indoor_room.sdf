<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="indoor_room">
    <physics type="ode">
      <real_time_update_rate>400.0</real_time_update_rate>
      <max_step_size>0.0025</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Enclosed Room Walls (8m x 8m) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.0 1.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Interior Partition (creates two rooms with a 1.2m doorway) -->
    <model name="wall_partition">
      <static>true</static>
      <pose>0 1.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 5.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.0 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Indoor Furniture / Obstacles with Distinct Color Signatures -->
    <!-- Table / Desk (Mahogany Brown) -->
    <model name="table_desk">
      <static>true</static>
      <pose>-2 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.45 0.20 0.08 1</ambient>
            <diffuse>0.45 0.20 0.08 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Chair / Seat (Canary Yellow) -->
    <model name="box_obstacle_1">
      <static>true</static>
      <pose>-2 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.95 0.88 0.05 1</ambient>
            <diffuse>0.95 0.88 0.05 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar / Column in Room 2 (Indigo Column) -->
    <model name="pillar_cylinder">
      <static>true</static>
      <pose>2 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.05 0.80 1</ambient>
            <diffuse>0.35 0.05 0.80 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Storage Cabinet in Room 2 (Cobalt Blue) -->
    <model name="cabinet">
      <static>true</static>
      <pose>3.5 -1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.8 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.8 1.2</size></box></geometry>
          <material>
            <ambient>0.05 0.15 0.95 1</ambient>
            <diffuse>0.05 0.15 0.95 1</diffuse>
            <specular>0.3 0.3 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stool in Hallway (Neutral Dark Grey) -->
    <model name="small_box">
      <static>true</static>
      <pose>1.5 -2.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Visual Semantic Signs ================= -->
    <!-- Exit Sign on West Wall near Entrance -->
    <model name="sign_exit">
      <static>true</static>
      <pose>-3.88 -2.0 0.55 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.04 0.70 0.35</size></box></geometry>
          <material>
            <ambient>0.0 0.95 0.15 1</ambient>
            <diffuse>0.0 0.95 0.15 1</diffuse>
            <emissive>0.0 0.55 0.10 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Doorway Waypoint Sign at Partition Opening (Mounted on Wall Header) -->
    <model name="sign_doorway">
      <static>true</static>
      <pose>0.0 -0.90 0.95 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.25 0.12 0.50</size></box></geometry>
          <material>
            <ambient>0.0 0.85 1.0 1</ambient>
            <diffuse>0.0 0.85 1.0 1</diffuse>
            <emissive>0.0 0.45 0.80 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Restroom Sign on Room 2 North Wall -->
    <model name="sign_restroom">
      <static>true</static>
      <pose>2.0 3.88 0.55 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.70 0.04 0.35</size></box></geometry>
          <material>
            <ambient>1.0 0.05 0.65 1</ambient>
            <diffuse>1.0 0.05 0.65 1</diffuse>
            <emissive>0.70 0.05 0.45 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Dynamic Moving Obstacle: Indoor Human ================= -->
    <!-- Humanoid pedestrian walking naturally across the indoor rooms -->
    <model name="indoor_human">
      <pose>0.2 -1.4 0.85 0 0 1.57</pose>
      <link name="link">
        <inertial>
          <mass>70.0</mass>
          <inertia>
            <ixx>15.0</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
            <iyy>15.0</iyy><iyz>0.0</iyz><izz>4.0</izz>
          </inertia>
        </inertial>
        <collision name="body_col">
          <geometry><cylinder><radius>0.22</radius><length>1.70</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.01</mu>
                <mu2>0.01</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- Torso with bright red jacket -->
        <visual name="torso">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.10 0.10 1.0</ambient>
            <diffuse>0.95 0.10 0.10 1.0</diffuse>
          </material>
        </visual>
        <!-- Head -->
        <visual name="head">
          <pose>0 0 0.68 0 0 0</pose>
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material>
            <ambient>0.82 0.65 0.52 1.0</ambient>
            <diffuse>0.88 0.70 0.58 1.0</diffuse>
          </material>
        </visual>
        <!-- Legs/Jeans -->
        <visual name="legs">
          <pose>0 0 -0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.20 0.25 1.0</ambient>
            <diffuse>0.25 0.25 0.30 1.0</diffuse>
          </material>
        </visual>
        <!-- Backpack -->
        <visual name="backpack">
          <pose>-0.14 0 0.15 0 0 0</pose>
          <geometry><box><size>0.16 0.26 0.40</size></box></geometry>
          <material>
            <ambient>0.95 0.10 0.10 1.0</ambient>
            <diffuse>0.95 0.10 0.10 1.0</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/indoor_human/cmd_vel</topic>
      </plugin>
    </model>

  </world>
</sdf>
